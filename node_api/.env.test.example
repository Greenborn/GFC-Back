# Copiar a .env.test y ajustar valores.
# Usado por scripts/test-db-setup.sh y por tests/integration/helpers/server.js

# Credenciales admin de MariaDB para crear la DB/usuario de pruebas
TEST_DB_ROOT_USER=root
TEST_DB_ROOT_PASSWORD=

# Conexión a MariaDB
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306

# Base de datos y usuario de pruebas (se crean automáticamente)
TEST_DB_NAME=gfc_test
TEST_DB_USER=gfc_test_user
TEST_DB_PASSWORD=gfc_test_password

# Puerto donde se levanta la API durante los tests de integración
TEST_API_PORT=3099

# Usuario admin ya existente (o creado por un seed) para los tests que requieren login
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=admin
